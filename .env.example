# ─────────────────────────────────────────────────────────────
# Supabase — proyecto en supabase.com (o local con Supabase CLI)
# ─────────────────────────────────────────────────────────────
# Públicas (seguras para el navegador). RLS protege el acceso.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...

# PRIVADA — solo servidor. Salta RLS. NUNCA exponer al cliente
# ni prefijar con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...

# ─────────────────────────────────────────────────────────────
# Motor de conciliación (corre dentro de la app, src/lib/motor)
# ─────────────────────────────────────────────────────────────
# Tope de partidas por lado en una conciliación. Por defecto 20.000, holgado
# para una PyME (500-2.000 movimientos). Protege la memoria del servidor y el
# tamaño del resultado que se guarda en la fila del job.
# MAX_FILAS_CONCILIACION=50000

# ─────────────────────────────────────────────────────────────
# IA: capa de adjudicación del motor + asistente (solo servidor)
# ─────────────────────────────────────────────────────────────
# Una sola clave para las dos cosas:
#  - La capa de IA del motor: propone pares en los casos dudosos.
#  - El asistente: explica la revisión previa del Paso 3 y por qué una
#    partida no se concilió.
# SIN esta clave la conciliación funciona igual (exacta, difusa y agrupación);
# simplemente no hay sugerencias de IA y el asistente no se ofrece.
# OPENAI_API_KEY=sk-...
# Modelo. Por defecto gpt-5.6-luna (el que usaba el flujo de n8n).
# OPENAI_MODEL=gpt-5.6-luna
# Otro modelo SOLO para la capa de IA del motor (opcional; si falta, OPENAI_MODEL).
# OPENAI_MODEL_CONCILIACION=gpt-5.6-luna
# Esfuerzo de razonamiento, SOLO para el chat general con consultas a datos.
# Los modelos de razonamiento (familia gpt-5) rechazan las herramientas en
# /v1/chat/completions si el razonamiento está activo; por defecto se manda
# "none", que además es lo correcto aquí (el modelo elige una consulta y repite
# cifras ya calculadas: no hay nada que razonar). Si tu modelo pide otro valor,
# `node ops/verificar-modelo.mjs` te dice cuál.
# OPENAI_REASONING_EFFORT=none
