# ─────────────────────────────────────────────────────────────
# Supabase — proyecto en supabase.com (o local con Supabase CLI)
# ─────────────────────────────────────────────────────────────
# Públicas (seguras para el navegador). RLS protege el acceso.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...

# PRIVADA — solo servidor. Salta RLS. NUNCA exponer al cliente
# ni prefijar con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...

# ─────────────────────────────────────────────────────────────
# n8n — motor de conciliación externo (solo servidor)
# ─────────────────────────────────────────────────────────────
# URL del webhook que dispara el flujo de conciliación.
N8N_WEBHOOK_URL=https://TU-N8N/webhook/conciliacion
# Token secreto compartido. El backend lo envía en el header
# Authorization/x-n8n-token; n8n rechaza requests sin él.
N8N_WEBHOOK_TOKEN=cambia-este-token-secreto

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
# URL pública de la app (para construir callback_url hacia n8n).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Tope de partidas por lado en una conciliación. Por defecto 20.000, que es
# holgado para una PyME (500-2.000 movimientos) y cabe en el payload de n8n.
# Subirlo exige subir TAMBIÉN N8N_PAYLOAD_SIZE_MAX en n8n: cada fila pesa ~194
# bytes, así que 50.000 partidas por lado son ~19 MB contra un tope de 16.
# MAX_FILAS_CONCILIACION=50000

# ─────────────────────────────────────────────────────────────
# Asistente IA (opcional, solo servidor)
# ─────────────────────────────────────────────────────────────
# Explica la revisión previa del Paso 3 y por qué una partida no se concilió.
# SIN esta clave el asistente simplemente NO se ofrece: el análisis
# determinístico que hay debajo sigue funcionando igual. Es un extra, no el
# contenido.
# Mismo proveedor que el motor en n8n: una credencial y una factura.
# OPENAI_API_KEY=sk-...
# Modelo. Por defecto el mismo que usa el flujo de n8n.
# OPENAI_MODEL=gpt-5.6-luna
# Esfuerzo de razonamiento, SOLO para el chat general con consultas a datos.
# Los modelos de razonamiento (familia gpt-5) rechazan las herramientas en
# /v1/chat/completions si el razonamiento está activo; por defecto se manda
# "none", que además es lo correcto aquí (el modelo elige una consulta y repite
# cifras ya calculadas: no hay nada que razonar). Si tu modelo pide otro valor,
# `node ops/verificar-modelo.mjs` te dice cuál.
# OPENAI_REASONING_EFFORT=none
